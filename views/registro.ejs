<%- include('partials/header') %>
<div class="acceso">
  <%- include('partials/panel-marca') %>

  <section class="acceso-form">
    <div class="form-caja">
      <h1>Crear cuenta</h1>
      <p class="sub">Las cuentas nuevas empiezan como Empleado de Ventas. El administrador puede cambiar tu rol.</p>

      <% if (error) { %><div class="alerta error"><%= error %></div><% } %>

      <form action="/registro" method="POST">
        <label for="nombre">Nombre completo</label>
        <input id="nombre" type="text" name="nombre" value="<%= datos.nombre || '' %>" required>

        <label for="email">Email</label>
        <input id="email" type="email" name="email" value="<%= datos.email || '' %>" required>

        <div class="dos-columnas">
          <div>
            <label for="password">Contraseña</label>
            <input id="password" type="password" name="password" required
                   pattern="(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z0-9]).{8,}"
                   title="Mínimo 8 caracteres, una mayúscula, un número y un carácter especial">
          </div>
          <div>
            <label for="confirmar">Confirmar</label>
            <input id="confirmar" type="password" name="confirmar" required>
          </div>
        </div>
        <p class="ayuda">Mínimo 8 caracteres, con una mayúscula, un número y un carácter especial.</p>

        <label for="tienda_id">Tienda asignada</label>
        <select id="tienda_id" name="tienda_id" required>
          <option value="">Selecciona tu tienda</option>
          <% tiendas.forEach(t => { %>
            <option value="<%= t.id %>" <%= String(datos.tienda_id) === String(t.id) ? 'selected' : '' %>><%= t.nombre %></option>
          <% }) %>
        </select>

        <button class="btn btn-principal btn-ancho" type="submit">Crear cuenta</button>
      </form>
      <p class="pie">¿Ya tienes cuenta? <a href="/login">Iniciar sesión</a></p>
    </div>
  </section>
</div>
<%- include('partials/footer') %>