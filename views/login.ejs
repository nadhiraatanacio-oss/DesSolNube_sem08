<%- include('partials/header') %>
<div class="acceso">
  <%- include('partials/panel-marca') %>

  <section class="acceso-form">
    <div class="form-caja">
      <h1>Iniciar sesión</h1>
      <p class="sub">Ingresa con tu cuenta de TechStore.</p>

      <% if (error) { %><div class="alerta error"><%= error %></div><% } %>
      <% if (ok) { %><div class="alerta ok"><%= ok %></div><% } %>

      <form action="/login" method="POST">
        <label for="email">Email</label>
        <input id="email" type="email" name="email" placeholder="nombre@techstore.com" required>
        <label for="password">Contraseña</label>
        <input id="password" type="password" name="password" required>
        <button class="btn btn-principal btn-ancho" type="submit">Iniciar sesión</button>
      </form>

      <div class="separador"><span>o continúa con</span></div>

      <div class="sociales">
        <a class="btn-social <%= google ? '' : 'inactivo' %>" href="/auth/google">
          <svg viewBox="0 0 24 24"><path fill="#EA4335" d="M12 10.2v3.9h5.4c-.2 1.3-1.6 3.8-5.4 3.8-3.2 0-5.9-2.7-5.9-6s2.7-6 5.9-6c1.9 0 3.1.8 3.8 1.5l2.6-2.5C16.8 3.4 14.6 2.4 12 2.4 6.7 2.4 2.4 6.7 2.4 12s4.3 9.6 9.6 9.6c5.5 0 9.2-3.9 9.2-9.4 0-.6-.1-1.1-.2-1.6H12z"/></svg>
          Google
        </a>
        <a class="btn-social <%= github ? '' : 'inactivo' %>" href="/auth/github">
          <svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 2.2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.3-3.4-1.3-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.300 1.1 2.9.8.1-.6.3-1.1.6-1.3-2.2-.3-4.6-1.1-4.6-5a3.9 3.9 0 0 1 1-2.7c-.1-.3-.4-1.3.1-2.700 0 0 .8-.3 2.8 1a9.6 9.6 0 0 1 5 0c1.900-1.3 2.8-1 2.8-1 .5 1.4.2 2.4.1 2.7a3.9 3.9 0 0 1 1 2.7c0 3.9-2.3 4.7-4.6 5 .4.3.7.9.7 1.9v2.8c0 .3.2.6.7.5A10 10 0 0 0 12 2.2z"/></svg>
          GitHub
        </a>
      </div>

      <p class="pie">¿No tienes cuenta? <a href="/registro">Crear una cuenta</a></p>
    </div>
  </section>
</div>
<%- include('partials/footer') %>